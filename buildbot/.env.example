# BuildBot Configuration

# LLM Service (Ollama or OpenAI-compatible API)
LLM_URL=http://localhost:11434
LLM_MODEL=llama3

# Jenkins Configuration
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=your_api_token_here
JENKINS_JOB=hotfix-build

# Google Chat Webhook (optional)
GCHAT_WEBHOOK_URL=

# Email Configuration (optional - use Papercut/MailHog locally)
SMTP_HOST=localhost
SMTP_PORT=25
EMAIL_FROM=buildbot@local
EMAIL_TO=dev@local
